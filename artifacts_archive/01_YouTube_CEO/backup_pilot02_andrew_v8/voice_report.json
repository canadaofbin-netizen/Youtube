      "act_boundary_after": false,
      "start_sec": 0.0,
      "end_sec": 3.6,
      "duration_sec": 3.6,
      "text": "Three hours into your first hotel night, your eyes fly wide open in the dark!",
      "display_text": "3 hours into your first hotel night, your eyes fly wide open in the dark!"
    },
    {
      "sentence_index": 2,
      "speaker": "narrator",
      "act_boundary_after": false,
      "start_sec": 3.84,
      "end_sec": 6.84,
      "duration_sec": 3.0,
      "text": "But back in your own warm bed, loud sirens outside never wake you up.",
      "display_text": "But back in your own warm bed, loud sirens outside never wake you up."
    },
    {
      "sentence_index": 3,
      "speaker": "narrator",
      "act_boundary_after": true,
      "start_sec": 7.08,
      "end_sec": 10.4,
      "duration_sec": 3.32,
      "text": "Quit blaming scratchy hotel sheets — your skull just flipped on a night patrol!",
      "display_text": "Quit blaming scratchy hotel sheets, your skull just flipped on a night patrol!"
    },
    {
      "sentence_index": 4,
      "speaker": "foil",
      "act_boundary_after": false,
      "start_sec": 10.66,
      "end_sec": 14.27,
      "duration_sec": 3.61,
      "text": "The front clerk grins and blames late coffee or jet lag for your bad night.",
      "display_text": "The front clerk grins and blames late coffee or jet lag for your bad night."
    },
    {
      "sentence_index": 5,
      "speaker": "narrator",
      "act_boundary_after": false,
      "start_sec": 14.53,
      "end_sec": 19.8,
      "duration_sec": 5.27,
      "text": "Yuka Sasaki scanned thirty-five sleepers over two straight nights, like a side-by-side bed test.",
      "display_text": "Yuka Sasaki scanned 35 sleepers over two straight nights, like a side-by-side bed test."
    },
    {
      "sentence_index": 6,
      "speaker": "narrator",
      "act_boundary_after": true,
      "start_sec": 20.06,
      "end_sec": 23.3,
      "duration_sec": 3.24,
      "text": "On night one, brain waves on the right side showed deep, quiet rest.",
      "display_text": "On night one, brain waves on the right side showed deep, quiet rest."
    },
    {
      "sentence_index": 7,
      "speaker": "narrator",
      "act_boundary_after": false,
      "start_sec": 23.62,
      "end_sec": 26.01,
      "duration_sec": 2.39,
      "text": "Wait, what happened inside the left half of the head?",
      "display_text": "Wait, what happened inside the left half of the head?"
    },
    {
      "sentence_index": 8,
      "speaker": "foil",
      "act_boundary_after": false,
      "start_sec": 26.27,
      "end_sec": 29.36,
      "duration_sec": 3.09,
      "text": "A lab helper bets both sides of your brain shut off once you snore.",
      "display_text": "A lab helper bets both sides of your brain shut off once you snore."
    },
    {
      "sentence_index": 9,
      "speaker": "narrator",
      "act_boundary_after": true,
      "start_sec": 29.6,
      "end_sec": 33.42,
      "duration_sec": 3.82,
      "text": "Wrong — left waves stayed light, waking people three times faster, like a tripwire!",
      "display_text": "Wrong, left waves stayed light, waking people 3 times faster, like a tripwire!"
    },
    {
      "sentence_index": 10,
      "speaker": "narrator",
      "act_boundary_after": false,
      "start_sec": 33.68,
      "end_sec": 37.22,
      "duration_sec": 3.54,
      "text": "Sea whales and wild birds sleep with one half awake so sharks cannot sneak up.",
      "display_text": "Sea whales and wild birds sleep with one half awake so sharks cannot sneak up."
    },
    {
      "sentence_index": 11,
      "speaker": "narrator",
      "act_boundary_after": false,
      "start_sec": 37.48,
      "end_sec": 42.27,
      "duration_sec": 4.79,
      "text": "Sleep labs even trash night-one charts since new rooms twist every wave trace.",
      "display_text": "Sleep labs even trash night-one charts since new rooms twist every wave trace."
    },
    {
      "sentence_index": 12,
      "speaker": "foil",
      "act_boundary_after": false,
      "start_sec": 42.59,
      "end_sec": 46.65,
      "duration_sec": 4.06,
      "text": "Wait, your travel friend asks, cannot foam plugs and dark curtains trick that alarm?",
      "display_text": "Wait, your travel friend asks, cannot foam plugs and dark curtains trick that alarm?"
    },
    {
      "sentence_index": 13,
      "speaker": "narrator",
      "act_boundary_after": true,
      "start_sec": 46.89,
      "end_sec": 50.66,
      "duration_sec": 3.77,
      "text": "Except one soft step outside your door still jolts that guard wide awake!",
      "display_text": "Except one soft step outside your door still jolts that guard wide awake!"
    },
    {
      "sentence_index": 14,
      "speaker": "narrator",
      "act_boundary_after": false,
      "start_sec": 50.92,
      "end_sec": 54.29,
      "duration_sec": 3.37,
      "text": "You see, your default mode network, your daydream network, stays clocked in.",
      "display_text": "You see, your default mode network, your daydream network, stays clocked in."
    },
    {
      "sentence_index": 15,
      "speaker": "narrator",
      "act_boundary_after": true,
      "start_sec": 54.55,
      "end_sec": 59.66,
      "duration_sec": 5.11,
      "text": "Bright red sparks hold the left side ready while your auditory cortex, your sound center, scans.",
      "display_text": "Bright red sparks hold the left side ready while your auditory cortex, your sound center, scans."
    },
    {
      "sentence_index": 16,
      "speaker": "narrator",
      "act_boundary_after": false,
      "start_sec": 59.92,
      "end_sec": 63.58,
      "duration_sec": 3.66,
      "text": "Once night two hits in that same room, the guard stands down and both halves rest.",
      "display_text": "Once night two hits in that same room, the guard stands down and both halves rest."
    },
    {
      "sentence_index": 17,
      "speaker": "narrator",
      "act_boundary_after": false,
      "start_sec": 63.84,
      "end_sec": 66.47,
      "duration_sec": 2.63,
      "text": "Do you pack a home pillowcase to calm that guard, or let it watch?",
      "display_text": "Do you pack a home pillowcase to calm that guard, or let it watch?"
    },
    {
      "sentence_index": 18,
      "speaker": "narrator",
      "act_boundary_after": false,
      "start_sec": 66.71,
      "end_sec": 69.53,
      "duration_sec": 2.82,
      "text": "Sleep in a new bed tonight — half your head dreams while half keeps watch!",
      "display_text": "Sleep in a new bed tonight, half your head dreams while half keeps watch!"
    }
  ],
